module xor_gate(a,b,y);
    //DIRECTIONS
    input a,b;
    output y;

        //INTERNAL SIGNALS
            wire w1,w2,w3,w4,w5;
            supply1 VDD;
            supply0 GND;
            //INSTANTSIATION
                pmos p1(w1,VDD,~a);
                pmos p2(w2,VDD,b);
                pmos p3(w3,w1,a);
                pmos p4(w3,w2,~b);
                pmos p5(y,VDD,w3);

                nmos n1(w3,w4,b);
                nmos n2(w3,w5,~b);
                nmos n3(w4,GND,~a);
                nmos n4(w5,GND,a);
                nmos n5(y,GND,w3);
endmodule
